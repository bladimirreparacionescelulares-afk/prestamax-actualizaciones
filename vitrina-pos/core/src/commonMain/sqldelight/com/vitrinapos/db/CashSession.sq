CREATE TABLE cashSession (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  openedAt INTEGER NOT NULL,
  openingAmount INTEGER NOT NULL,
  closedAt INTEGER,
  expectedAmount INTEGER,
  countedAmount INTEGER,
  notes TEXT NOT NULL DEFAULT '',
  deviceId TEXT NOT NULL DEFAULT '',
  userName TEXT NOT NULL DEFAULT '',
  branchId INTEGER NOT NULL DEFAULT 1
);

-- Entradas y salidas de efectivo de una caja (gastos, retiros, cambio, devoluciones).
CREATE TABLE cashMove (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  sessionId INTEGER NOT NULL,
  type TEXT NOT NULL,
  amount INTEGER NOT NULL,
  note TEXT NOT NULL DEFAULT '',
  userName TEXT NOT NULL DEFAULT '',
  createdAt INTEGER NOT NULL
);

CREATE INDEX cashMove_session ON cashMove(sessionId);

selectOpen:
SELECT * FROM cashSession WHERE closedAt IS NULL AND deviceId = ? ORDER BY openedAt DESC LIMIT 1;

selectById:
SELECT * FROM cashSession WHERE id = ?;

selectRecent:
SELECT * FROM cashSession WHERE deviceId = ? ORDER BY openedAt DESC LIMIT 30;

open:
INSERT INTO cashSession(openedAt, openingAmount, deviceId, userName) VALUES (?, ?, ?, ?);

close:
UPDATE cashSession SET closedAt = ?, expectedAmount = ?, countedAmount = ?, notes = ? WHERE id = ?;

claimOrphans:
UPDATE cashSession SET deviceId = ? WHERE deviceId = '';

insertMove:
INSERT INTO cashMove(sessionId, type, amount, note, userName, createdAt) VALUES (?, ?, ?, ?, ?, ?);

movesBySession:
SELECT * FROM cashMove WHERE sessionId = ? ORDER BY createdAt;
