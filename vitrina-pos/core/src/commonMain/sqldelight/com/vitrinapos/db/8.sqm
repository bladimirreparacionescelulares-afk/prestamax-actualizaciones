-- Versión 8 -> 9: sucursales. Todo lo que había pasa a la sucursal 1, "Principal".
CREATE TABLE branch (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  address TEXT NOT NULL DEFAULT '',
  phone TEXT NOT NULL DEFAULT '',
  active INTEGER NOT NULL DEFAULT 1,
  createdAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE branchStock (
  key TEXT NOT NULL PRIMARY KEY,
  productId INTEGER NOT NULL,
  branchId INTEGER NOT NULL,
  qty REAL NOT NULL DEFAULT 0
);

CREATE INDEX branchStock_branch ON branchStock(branchId);
CREATE INDEX branchStock_product ON branchStock(productId);

INSERT INTO branch(id, name, address, phone, active, createdAt)
SELECT 1, 'Principal', COALESCE((SELECT trim(content, '"') FROM setting WHERE key = 'address'), ''), COALESCE((SELECT trim(content, '"') FROM setting WHERE key = 'phone'), ''), 1, 0;

INSERT INTO branchStock(key, productId, branchId, qty) SELECT id || ':1', id, 1, stock FROM product;

ALTER TABLE stockMove ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE sale ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE cashSession ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE repairOrder ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE productUnit ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE purchase ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE saleReturn ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE stockCount ADD COLUMN branchId INTEGER NOT NULL DEFAULT 1;
ALTER TABLE appUser ADD COLUMN branches TEXT NOT NULL DEFAULT '';

-- Las filas nuevas se anotan para que los demás equipos las reciban.
INSERT INTO changeLog(tbl, rowKey) SELECT 'branch', id FROM branch;
INSERT INTO changeLog(tbl, rowKey) SELECT 'branchStock', key FROM branchStock;
