CREATE TABLE supplier (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  contact TEXT NOT NULL DEFAULT '',
  phone TEXT NOT NULL DEFAULT '',
  email TEXT NOT NULL DEFAULT '',
  docId TEXT NOT NULL DEFAULT '',
  address TEXT NOT NULL DEFAULT '',
  notes TEXT NOT NULL DEFAULT '',
  createdAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM supplier ORDER BY name COLLATE NOCASE;

selectById:
SELECT * FROM supplier WHERE id = ?;

insert:
INSERT INTO supplier(name, contact, phone, email, docId, address, notes, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE supplier SET name = ?, contact = ?, phone = ?, email = ?, docId = ?, address = ?, notes = ? WHERE id = ?;

delete:
DELETE FROM supplier WHERE id = ?;

clearFromProducts:
UPDATE product SET supplierId = NULL WHERE supplierId = ?;

lastId:
SELECT last_insert_rowid();
