-- Versión 3 -> 4: facturación electrónica (e-CF).
CREATE TABLE fiscalSequence (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  type INTEGER NOT NULL,
  fromNo INTEGER NOT NULL,
  toNo INTEGER NOT NULL,
  expiresAt INTEGER,
  deviceId TEXT NOT NULL DEFAULT '',
  parentId INTEGER,
  createdAt INTEGER NOT NULL
);

CREATE INDEX fiscalSequence_type ON fiscalSequence(type, deviceId);

CREATE TABLE ecfDoc (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  saleId INTEGER,
  type INTEGER NOT NULL,
  encf TEXT NOT NULL,
  status TEXT NOT NULL,
  xml TEXT NOT NULL,
  summaryXml TEXT NOT NULL DEFAULT '',
  securityCode TEXT NOT NULL,
  signedAt INTEGER NOT NULL,
  total INTEGER NOT NULL,
  buyerRnc TEXT NOT NULL DEFAULT '',
  buyerName TEXT NOT NULL DEFAULT '',
  refEncf TEXT NOT NULL DEFAULT '',
  trackId TEXT NOT NULL DEFAULT '',
  message TEXT NOT NULL DEFAULT '',
  attempts INTEGER NOT NULL DEFAULT 0,
  sentAt INTEGER,
  deviceId TEXT NOT NULL DEFAULT '',
  env TEXT NOT NULL DEFAULT '',
  createdAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL
);

CREATE UNIQUE INDEX ecfDoc_encf ON ecfDoc(encf);
CREATE INDEX ecfDoc_sale ON ecfDoc(saleId);
CREATE INDEX ecfDoc_status ON ecfDoc(status);

