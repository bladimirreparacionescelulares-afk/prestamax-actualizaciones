CREATE TABLE client (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  phone TEXT NOT NULL DEFAULT '',
  email TEXT NOT NULL DEFAULT '',
  docId TEXT NOT NULL DEFAULT '',
  address TEXT NOT NULL DEFAULT '',
  notes TEXT NOT NULL DEFAULT '',
  createdAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM client ORDER BY name COLLATE NOCASE;

selectById:
SELECT * FROM client WHERE id = ?;

insert:
INSERT INTO client(name, phone, email, docId, address, notes, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE client SET name = ?, phone = ?, email = ?, docId = ?, address = ?, notes = ? WHERE id = ?;

delete:
DELETE FROM client WHERE id = ?;

lastId:
SELECT last_insert_rowid();
