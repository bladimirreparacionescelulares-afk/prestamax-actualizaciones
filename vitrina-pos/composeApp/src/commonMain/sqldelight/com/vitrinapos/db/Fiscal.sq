-- Rangos de e-NCF autorizados por la DGII (deviceId = '') y bloques reservados para cada equipo.
CREATE TABLE fiscalSequence (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  type INTEGER NOT NULL,
  fromNo INTEGER NOT NULL,
  toNo INTEGER NOT NULL,
  expiresAt INTEGER,
  deviceId TEXT NOT NULL DEFAULT '',
  parentId INTEGER,
  createdAt INTEGER NOT NULL
);

CREATE INDEX fiscalSequence_type ON fiscalSequence(type, deviceId);

-- Comprobantes fiscales electrónicos emitidos (firmados) y su estado ante la DGII.
CREATE TABLE ecfDoc (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  saleId INTEGER,
  type INTEGER NOT NULL,
  encf TEXT NOT NULL,
  status TEXT NOT NULL,
  xml TEXT NOT NULL,
  summaryXml TEXT NOT NULL DEFAULT '',
  securityCode TEXT NOT NULL,
  signedAt INTEGER NOT NULL,
  total INTEGER NOT NULL,
  buyerRnc TEXT NOT NULL DEFAULT '',
  buyerName TEXT NOT NULL DEFAULT '',
  refEncf TEXT NOT NULL DEFAULT '',
  trackId TEXT NOT NULL DEFAULT '',
  message TEXT NOT NULL DEFAULT '',
  attempts INTEGER NOT NULL DEFAULT 0,
  sentAt INTEGER,
  deviceId TEXT NOT NULL DEFAULT '',
  env TEXT NOT NULL DEFAULT '',
  createdAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL
);

CREATE UNIQUE INDEX ecfDoc_encf ON ecfDoc(encf);
CREATE INDEX ecfDoc_sale ON ecfDoc(saleId);
CREATE INDEX ecfDoc_status ON ecfDoc(status);

ranges:
SELECT * FROM fiscalSequence WHERE deviceId = '' ORDER BY type, fromNo;

blocksFor:
SELECT * FROM fiscalSequence WHERE deviceId = ? AND type = ? ORDER BY fromNo;

blocksOfRange:
SELECT * FROM fiscalSequence WHERE parentId = ? ORDER BY fromNo;

allBlocks:
SELECT * FROM fiscalSequence WHERE deviceId != '' ORDER BY type, fromNo;

insertSequence:
INSERT INTO fiscalSequence(type, fromNo, toNo, expiresAt, deviceId, parentId, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSequence:
DELETE FROM fiscalSequence WHERE id = ?;

lastSequenceId:
SELECT last_insert_rowid();

insertDoc:
INSERT INTO ecfDoc(saleId, type, encf, status, xml, summaryXml, securityCode, signedAt, total, buyerRnc, buyerName, refEncf, deviceId, env, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

docBySale:
SELECT * FROM ecfDoc WHERE saleId = ? ORDER BY id;

docByEncf:
SELECT * FROM ecfDoc WHERE encf = ?;

docById:
SELECT * FROM ecfDoc WHERE id = ?;

recentDocs:
SELECT * FROM ecfDoc ORDER BY signedAt DESC LIMIT ?;

pendingDocs:
SELECT * FROM ecfDoc WHERE status IN ('SIGNED', 'SENT') ORDER BY signedAt;

maxUsedBetween:
SELECT max(CAST(substr(encf, 4) AS INTEGER)) FROM ecfDoc WHERE type = ? AND CAST(substr(encf, 4) AS INTEGER) BETWEEN ? AND ?;

setDocStatus:
UPDATE ecfDoc SET status = ?, trackId = ?, message = ?, attempts = attempts + ?, sentAt = coalesce(?, sentAt), updatedAt = ? WHERE id = ?;

attachSale:
UPDATE ecfDoc SET saleId = ? WHERE id = ?;

deleteDocsOfSale:
DELETE FROM ecfDoc WHERE saleId = ?;

lastDocId:
SELECT last_insert_rowid();
