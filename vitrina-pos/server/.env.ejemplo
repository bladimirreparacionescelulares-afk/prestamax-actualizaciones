# Copia este archivo como .env y llena los valores. NUNCA subas el .env al repositorio.
# Para generar llaves:  openssl rand -base64 32

# Contraseña de PostgreSQL (solo con docker-compose; en DigitalOcean se usa DATABASE_URL de la base administrada)
DB_PASSWORD=
# DATABASE_URL=jdbc:postgresql://HOST:25060/vitrina?user=USUARIO&password=CLAVE&sslmode=require

# Firma de las sesiones (32 bytes en base64)
TOKEN_SECRET=
# Llave maestra para cifrar el certificado de facturación de cada negocio (32 bytes en base64). Guárdala aparte: sin ella no se abren los certificados.
MASTER_KEY=
# Ficha del panel administrativo (solo para ti). Larga y secreta.
ADMIN_TOKEN=

# Correos (recuperar contraseña). Sin esto, los correos no se envían.
RESEND_API_KEY=
MAIL_FROM=Vitrina POS <no-responder@facturaprord.online>

# Prueba gratis
TRIAL_PLAN=pro
TRIAL_DAYS=14
